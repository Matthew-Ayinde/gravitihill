# Copy to .env.local and fill in. Never commit .env.local.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=
# MONGODB_DB=gravitihill

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Admin auth ───────────────────────────────────────────────────────────────
AUTH_SECRET=

# ─── Contact form email (Gmail SMTP) ──────────────────────────────────────────
# SMTP_PASS must be a Gmail App Password, not your normal password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords.
# Paste the 16 characters with or without the spaces Google shows.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (recommended). 587 = STARTTLS. Both work with Gmail.
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Optional. The From line visitors see. Gmail only honours an address that is
# SMTP_USER itself or a verified "Send mail as" alias on that account; the
# display name is free. Defaults to "Graviti Hill" <SMTP_USER>.
EMAIL_FROM="Graviti Hill <you@gmail.com>"

# Inbox(es) that receive the new-enquiry notification. Comma-separate several.
ADMIN_EMAIL=info@gravitihill.com

# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin; used for links in the emails.
# NEXT_PUBLIC_SITE_URL=https://gravitihill.com
